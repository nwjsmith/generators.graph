(ns com.theinternate.generators.graph
  (:require [clojure.set :as set]
            [clojure.test.check.generators :as gen]))

(defn- map-matrix-indexed
  "Returns a matrix consisting applying f to each entry, its row coordinate, and
  its column coordinate."
  [f matrix]
  (into []
        (map-indexed
         (fn mapped-row [row-index row]
           (into []
                 (map-indexed (fn mapped-vertex [column-index vertex]
                                (f row-index column-index vertex)))
                 row)))
        matrix))

(defn- map-matrix
  "Returns a square matrix consisting of applying f to each entry."
  [f matrix]
  (map-matrix-indexed (fn mapped-indexed-vertex
                          [_ _ vertex] (f vertex)) matrix))

(defn- empty-matrix
  "Returns a square matrix containing an entry with a `nil` value for each of
  the number of vertices."
  [vertex-count]
  (vec (repeat vertex-count (vec (repeat vertex-count nil)))))

(def ^:private gen-probability
  (gen/fmap (fn uniform-unit [n] (/ (double n) 1.0e9))
            (gen/choose 0 1000000000)))

(def ^:private gen-zero-probability
  (gen/return 0.0))

(defn- edge?
  "Returns true if the probability indicates the vertices are adjacent."
  [probability]
  (< 0.5 probability))

(defn- gen-directed-acyclic-cell
  "Returns the generator for the cell at [row col] of a probability matrix
  representing a directed, acyclic graph."
  [row col]
  (if (< col row) gen-probability gen-zero-probability))

(defn- gen-directed-cell
  "Returns the generator for the cell at [row col] of a probability matrix
  representing a directed graph."
  [row col]
  (if (= row col) gen-zero-probability gen-probability))

(defn- gen-probability-matrix
  "Generates a matrix containing a probability of there being an edge between
  two vertices. Each cell is generated by calling gen-cell with its row and
  column coordinates. It will contain entries for the given number of
  vertices."
  [vertex-count gen-cell]
  (apply gen/tuple
         (map (partial apply gen/tuple)
              (map-matrix-indexed (fn gen-probability-at [row col _]
                                      (gen-cell row col))
                                    (empty-matrix vertex-count)))))

(defn- symmetrical
  "Returns the matrix with its lower triangle mirrored into its upper
  triangle."
  [matrix]
  (map-matrix-indexed (fn mirror-upper [row col vertex]
                          (if (< row col)
                            (get-in matrix [col row])
                            vertex))
                        matrix))

(defn- gen-adjacency-matrix
  "Generates an adjacency matrix from the given probability matrix generator.
  Based on the algorithm described in Cordeiro, Daniel et al. Random Graph
  Generation for Scheduling Simulations."
  [gen-probability-matrix]
  (gen/fmap (fn truth-table [probability-matrix]
              (map-matrix edge? probability-matrix))
            gen-probability-matrix))

(defn- graph
  "Returns the directed graph represented by the adjacency matrix and the given
  vertices."
  [vertices matrix]
  (reduce (fn vertex-joined [m [row column :as coordinates]]
            (if (get-in matrix coordinates)
              (update m (nth vertices column) conj (nth vertices row))
              m))
          (zipmap vertices (repeat #{}))
          (for [row (range 0 (count vertices))
                column (range 0 (count vertices))]
            [row column])))

(defn gen-directed-acyclic-graph
  "Generates a random directed, acyclic graph containing the given vertices."
  [vertices]
  (gen/fmap (fn adjacency-list [[shuffled-vertices matrix]]
              (graph shuffled-vertices matrix))
            (gen/tuple (gen/shuffle vertices)
                       (gen-adjacency-matrix
                        (gen-probability-matrix (count vertices)
                                                gen-directed-acyclic-cell)))))

(defn gen-directed-graph
  "Generates a random directed graph containing the given vertices. The graph
  may contain cycles."
  [vertices]
  (gen/fmap (fn adjacency-list [[shuffled-vertices matrix]]
              (graph shuffled-vertices matrix))
            (gen/tuple (gen/shuffle vertices)
                       (gen-adjacency-matrix
                        (gen-probability-matrix (count vertices)
                                                gen-directed-cell)))))

(defn gen-undirected-graph
  "Generates a random undirected graph containing the given vertices."
  [vertices]
  (gen/fmap (fn adjacency-list [[shuffled-vertices matrix]]
              (graph shuffled-vertices matrix))
            (gen/tuple (gen/shuffle vertices)
                       (gen-adjacency-matrix
                        (gen/fmap symmetrical
                                  (gen-probability-matrix
                                   (count vertices)
                                   gen-directed-acyclic-cell))))))

(defn- vertices
  "Returns a set containing all of the directed graph's vertices."
  [directed-graph]
  (set (keys directed-graph)))

(defn- roots
  "Returns the set of vertices in the graph which have no incoming edges."
  [directed-graph]
  (into #{}
        (filter (fn root? [vertex]
                  (not-any? (fn contains-vertex? [adjacents]
                              (contains? adjacents vertex))
                            (vals directed-graph))))
        (vertices directed-graph)))

(defn- parent?
  "Returns true if the directed graph contains an edge from the vertex to the
  child."
  [directed-graph vertex child]
  (contains? (get directed-graph vertex) child))

(defn- interchange
  "Swaps the values at two indices in the associative collection."
  [coll index-one index-two]
  (assoc coll
         index-one (nth coll index-two)
         index-two (nth coll index-one)))

(defn- topological-ordering
  "Returns a topological ordering of the vertices in the directed, acyclic
  graph."
  [directed-acyclic-graph]
  (loop [ordered []
         remaining-roots (roots directed-acyclic-graph)
         remaining-graph directed-acyclic-graph]
    (if (seq remaining-roots)
      (let [root (first remaining-roots)
            graph-without-root (dissoc remaining-graph root)]
        (recur (conj ordered root)
               (set/union (disj remaining-roots root)
                          (roots graph-without-root))
               graph-without-root))
      ordered)))

(defn gen-topological-ordering
  "Generates a seq of all vertices in the directed, acyclic graph. The seq will
  be in topological order."
  [directed-acyclic-graph]
  (let [vertex-count (count directed-acyclic-graph)]
    (gen/fmap
     (fn interchanged-at-indices [random-indices]
       (reduce (fn interchanged-at-index [ordered-vertices random-index]
                 (let [next-index (inc random-index)]
                   (if (and (< next-index vertex-count)
                            (not (parent? directed-acyclic-graph
                                          (nth ordered-vertices random-index)
                                          (nth ordered-vertices next-index))))
                     (interchange ordered-vertices random-index next-index)
                     ordered-vertices)))
               (topological-ordering directed-acyclic-graph)
               random-indices))
     (gen/vector (gen/choose 0 (dec vertex-count))
                 (* 10 (Math/pow vertex-count 2))))))

(defn- keep-vertices
  "Returns a directed graph containing only the given vertices. Preserves the
  adjacency container type, so edges decorated with weights or other values
  are retained."
  [vertices directed-graph]
  (let [vertex? (set vertices)]
    (into {}
          (comp (filter (comp vertex? key))
                (map (fn entry-without-vertices [[vertex adjacents]]
                       [vertex (if (map? adjacents)
                                 (into {} (filter (comp vertex? key)) adjacents)
                                 (into #{} (filter vertex?) adjacents))])))
          directed-graph)))

(defn gen-ancestor-closed-subgraph
  "Generates an ancestor-closed subgraph of the directed, acyclic graph: a
  subset of its vertices closed under the ancestor relation, so including a
  vertex implies including all of its ancestors. The subgraph will contain at
  least the minimum number of vertices (default 0)."
  ([directed-acyclic-graph]
   (gen-ancestor-closed-subgraph directed-acyclic-graph
                                 {:minimum-vertex-count 0}))
  ([directed-acyclic-graph {:keys [minimum-vertex-count]}]
   (gen/bind
    (gen-topological-ordering directed-acyclic-graph)
    (fn pruned-from-end [ordering]
      (gen/fmap (fn vertices-removed [n]
                  (keep-vertices (drop-last n ordering) directed-acyclic-graph))
                (gen/choose 0 (max 0 (- (count ordering)
                                        minimum-vertex-count))))))))

(def ^{:deprecated true
       :doc "Deprecated alias for gen-ancestor-closed-subgraph."
       :arglists '([directed-acyclic-graph]
                   [directed-acyclic-graph {:keys [minimum-vertex-count]}])}
  gen-pruned-directed-acyclic-graph gen-ancestor-closed-subgraph)

(defn gen-weighted
  "Generates a weighted version of the directed graph. Each edge is assigned a
  non-negative integer weight. The weighted graph is represented as a map from
  each vertex to a map from its adjacents to their weights."
  [directed-graph]
  (let [edges (for [[vertex adjacents] directed-graph
                    adjacent adjacents]
                [vertex adjacent])]
    (gen/fmap (fn weighted-edges [weights]
                (reduce (fn weight-assigned [weighted [[vertex adjacent] weight]]
                          (update weighted vertex assoc adjacent weight))
                        (zipmap (keys directed-graph) (repeat {}))
                        (map vector edges weights)))
              (gen/vector gen/nat (count edges)))))
